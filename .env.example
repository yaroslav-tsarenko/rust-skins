# rust-skins.com environment
# Neon PostgreSQL — this project's OWN dedicated database
DATABASE_URL="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/rust_skins?sslmode=require"

# Session signing secret (generate a long random string)
AUTH_SECRET="change-me-to-a-long-random-secret-string"

# Public site URL (used for canonical URLs, emails, OG)
NEXT_PUBLIC_SITE_URL="https://www.rust-skins.com"

# SMTP for transactional email (leave blank to log emails to console in dev)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="rust-skins.com <info@rust-skins.com>"

# SMTP_PASSWORD is accepted as an alias for SMTP_PASS; SMTP_SECURE="true" forces TLS
SMTP_SECURE=""

# Steam Web API key (persona name + avatar after Steam sign-in)
STEAM_API_KEY=""

# SIH market (catalogue import, prices, purchases)
SIH_API_KEY=""
SIH_API_BASE="https://api.sih.market/api/v1"
SIH_APP_ID="252490"
SIH_WEBHOOK_SECRET=""
